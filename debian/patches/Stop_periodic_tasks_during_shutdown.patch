diff --git a/nova/manager.py b/nova/manager.py
index b9081e9..5eed009 100644
--- a/nova/manager.py
+++ b/nova/manager.py
@@ -55,6 +55,7 @@
 import time
 
 from oslo_log import log as logging
+from oslo_service import loopingcall
 from oslo_service import periodic_task
 
 import nova.conf
@@ -128,7 +129,11 @@
         """Tasks to be run at a periodic interval."""
         if self._shutdown_in_progress.is_set():
             LOG.debug('Skipping periodic tasks during graceful shutdown.')
-            return
+            # We either need to return a value or raise LoopingCallDone
+            # to avoid a RuntimeError in DynamicLoopingCall. As we
+            # are shutting down, we don't want to run any periodic tasks any
+            # more, so we raise.
+            raise loopingcall.LoopingCallDone()
         return self.run_periodic_tasks(context, raise_on_error=raise_on_error)
 
     def init_host(self, service_ref):
