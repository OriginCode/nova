#. Description
#: ../nova-common.templates.in:9001
msgid "Cinder os region name:"
msgstr "Naam van de os-regio voor Cinder:"

#. Type: string
#. Description
#: ../nova-common.templates.in:9001
msgid "Please enter the region name for cinder service."
